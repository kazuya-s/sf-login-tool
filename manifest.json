{
  "manifest_version": 3,
  "name": "KS SF Login",
  "version": "1.0.1",
  "description": "KS SF Login — Salesforce へのログインを簡単にする Chrome 拡張機能",
  "icons": {
    "16": "src/public/icons/16x16.png",
    "32": "src/public/icons/32x32.png",
    "48": "src/public/icons/64x64.png",
    "128": "src/public/icons/128x128.png"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "KS SF Login",
    "default_icon": {
      "16": "src/public/icons/16x16.png",
      "32": "src/public/icons/32x32.png",
      "48": "src/public/icons/64x64.png",
      "128": "src/public/icons/128x128.png"
    }
  },
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "permissions": ["storage", "cookies", "tabs", "alarms", "scripting", "notifications"],
  "host_permissions": [
    "https://login.salesforce.com/*",
    "https://test.salesforce.com/*",
    "https://*.salesforce.com/*",
    "https://*.my.salesforce.com/*",
    "https://*.lightning.force.com/*",
    "https://*.force.com/*"
  ]
}
